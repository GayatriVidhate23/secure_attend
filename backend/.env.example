# SecureAttend AI — Environment Configuration Example
# Copy to .env and adjust for your local network deployment.

# Application
APP_NAME=SecureAttend AI
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server — bind to all interfaces for LAN/mobile access
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/secureattend.db
SQLITE_WAL_MODE=true
SQLITE_BUSY_TIMEOUT_MS=5000

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Face verification proof
FACE_PROOF_SECRET_KEY=change-me-face-proof-secret
FACE_PROOF_EXPIRE_SECONDS=120

# QR authentication
QR_HMAC_SECRET_KEY=change-me-qr-hmac-secret
QR_ROTATION_INTERVAL_SECONDS=15
QR_CLOCK_SKEW_TOLERANCE_SECONDS=5

# Face recognition model
FACE_MODEL_NAME=buffalo_sc
FACE_MODEL_VERSION=1.0
FACE_VERIFICATION_THRESHOLD=0.45
FACE_EMBEDDING_DIM=512

# Liveness
LIVENESS_CHALLENGE_EXPIRE_SECONDS=60
LIVENESS_PASS_THRESHOLD=0.6

# Attendance
ATTENDANCE_WINDOW_MINUTES_BEFORE=10
ATTENDANCE_WINDOW_MINUTES_AFTER=15

# Rate limiting
LOGIN_RATE_LIMIT_PER_MINUTE=10
ATTENDANCE_MARK_RATE_LIMIT_PER_MINUTE=5

# CORS — comma-separated origins (no wildcard in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin web portal
ADMIN_WEB_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Biometric retention (days, 0 = metadata only after processing)
BIOMETRIC_SAMPLE_RETENTION_DAYS=0
